{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{"type":"header","key":"host","value":"smitsircommerce.in"}],
      "destination": "https://www.smitsircommerce.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type":"header","key":"host","value":"smitsircommerce.vercel.app"}],
      "destination": "https://www.smitsircommerce.in/:path*",
      "permanent": true
    },
    {
      "source": "/accountancy-tuition-mehsana",
      "destination": "/tools",
      "permanent": true
    }
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]},
    {"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/materials/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=604800, stale-while-revalidate=86400"}]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
    {"source":"/registerSW.js","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
    {"source":"/admin","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, nosnippet"}]},{"source":"/admin/students","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, nosnippet"}]},{"source":"/admin/leads","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, nosnippet"}]},{"source":"/admin/demos","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, nosnippet"}]},{"source":"/admin-studio","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, nosnippet"}]},{"source":"/login","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, nosnippet"}]},{"source":"/onboarding","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, nosnippet"}]},{"source":"/dashboard","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, nosnippet"}]},{"source":"/learning-insights","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, nosnippet"}]},{"source":"/my-data","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, nosnippet"}]},{"source":"/demo-success","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, nosnippet"}]},{"source":"/pdf-viewer","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, nosnippet"}]},{"source":"/reel","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, nosnippet"}]},{"source":"/lectures","headers":[{"key":"X-Robots-Tag","value":"noindex, follow"}]}
