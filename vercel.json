{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/materials/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet" }]
    },
    {
      "source": "/login",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet" }]
    },
    {
      "source": "/dashboard",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet" }]
    },
    {
      "source": "/pdf-viewer",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet" }]
    },
    {
      "source": "/reel",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet" }]
    },
    {
      "source": "/lectures",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ],
  "rewrites": [
    { "source": "/courses", "destination": "/" },
    { "source": "/lectures", "destination": "/" },
    { "source": "/study-material", "destination": "/" },
    { "source": "/pdf-viewer", "destination": "/" },
    { "source": "/quizzes", "destination": "/" },
    { "source": "/test-series", "destination": "/" },
    { "source": "/live-classes", "destination": "/" },
    { "source": "/online-batch", "destination": "/" },
    { "source": "/offline-batch", "destination": "/" },
    { "source": "/dashboard", "destination": "/" },
    { "source": "/parent-info", "destination": "/" },
    { "source": "/about", "destination": "/" },
    { "source": "/contact", "destination": "/" },
    { "source": "/faq", "destination": "/" },
    { "source": "/games", "destination": "/" },
    { "source": "/flashcards", "destination": "/" },
    { "source": "/ask", "destination": "/" },
    { "source": "/reel", "destination": "/" },
    { "source": "/login", "destination": "/" },
    { "source": "/admin", "destination": "/" }
  ]
}
